# Gemini API key: set only in Netlify Environment Variables, never in browser files.
ERSYA_GEMINI_API_KEY=
ERSYA_GEMINI_MODEL=gemini-3.5-flash-lite
# Optional overrides; do not use a Supabase service_role key here.
# ERSYA_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# ERSYA_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
